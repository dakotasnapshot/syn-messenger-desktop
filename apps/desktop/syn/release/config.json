    "disable_custom_urls": false,
    "disable_guests": true,
    "disable_login_language_selector": false,
    "disable_3pid_login": false,
    "force_verification": false,
    "brand": "Syndicate",
    "permalink_prefix": "https://synmessenger.com/chat/",
    "default_device_display_name": "SYN Desktop",
    "default_theme": "dark",
    "mobile_guide_toast": false,
    "show_labs_settings": false,
    "room_directory": {
        "servers": ["matrix.org"]
    },
    "branding": {
        "welcome_background_url": "https://synmessenger.com/web-background.svg",
        "logo_link_url": "https://synmessenger.com/",
        "auth_header_logo_url": "https://synmessenger.com/logo.svg",
        "auth_footer_links": [
            { "text": "Privacy", "url": "https://synmessenger.com/privacy.html" },
            { "text": "Terms", "url": "https://synmessenger.com/terms.html" },
            { "text": "Support", "url": "https://synmessenger.com/support.html" }
        ]
    },
    "desktop_builds": {
