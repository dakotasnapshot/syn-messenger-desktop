{
    "update_base_url": "https://synmessenger.com/desktop/update/",
    "help_url": "https://synmessenger.com/support.html",
    "help_encryption_url": "https://synmessenger.com/support.html#encryption",
    "help_key_storage_url": "https://synmessenger.com/support.html#recovery",
    "default_server_config": {
        "m.homeserver": {
            "base_url": "https://matrix-client.matrix.org",
            "server_name": "matrix.org"
        }
